[Unit]
Description=rclone remote control for Aurora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurora
Group=aurora
EnvironmentFile=/etc/rclone-rc.env
Environment=HOME=/var/lib/aurora
# rclone reads RCLONE_RC_USER/RCLONE_RC_PASS from EnvironmentFile;
# credentials are not placed in the process command line.
ExecStart=/usr/bin/rclone rcd --rc-addr 127.0.0.1:5572 --rc-baseurl /rclone/ --rc-web-gui --rc-web-gui-no-open-browser --config /var/lib/aurora/rclone/rclone.conf --log-level ERROR
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurora/rclone /var/lib/aurora/.cache

[Install]
WantedBy=multi-user.target
