[Unit]
Description=rclone remote control for Aurora
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aurora
Group=aurora
EnvironmentFile=/etc/rclone-rc.env
ExecStart=/usr/bin/rclone rcd --rc-addr 127.0.0.1:5572 --rc-user=${RCLONE_RC_USER} --rc-pass=${RCLONE_RC_PASS} --config /var/lib/aurora/rclone/rclone.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aurora/rclone /var/lib/aurora/media
