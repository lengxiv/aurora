# Replace dashboard.example.com and certificate paths before enabling this file.

# 登录接口限速：后端有按 IP 的 5 次失败锁定，nginx 这层再挡一轮洪泛
limit_req_zone $binary_remote_addr zone=aurora_login:10m rate=10r/m;

server {
    listen 80;
    server_name dashboard.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name dashboard.example.com;

    ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 后端允许 20MB 种子 / 2GB 网盘上传；nginx 默认 1MB 会让公网上传全部 413
    client_max_body_size 2g;
    # 2GB 上传不整段缓冲，边收边转发
    proxy_request_buffering off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location /api/auth/login {
        limit_req zone=aurora_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}
