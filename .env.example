# Copy this file to a private environment file. Never commit the copy.

# Application
# AURORA_HOST/AURORA_PORT 只在 `python main.py` 直跑时生效；
# systemd 部署的监听地址由 aurora.service 的 ExecStart 决定，
# 容器部署的监听地址由镜像 CMD 决定（0.0.0.0:8787）
AURORA_HOST=127.0.0.1
AURORA_PORT=8787
AURORA_STATE_DIR=/var/lib/aurora
AURORA_DATA_DIR=/var/lib/aurora/data
AURORA_LOCAL_MOUNT=/srv/aurora/media

# 版本号与在线检查更新
# AURORA_VERSION 覆盖仓库根目录 VERSION 文件读取的版本号（一般无需设置）
# AURORA_REPO 用于设置页「检查更新」对比 GitHub Releases，
# 支持 owner/repo 或完整 URL；留空回退默认仓库
AURORA_VERSION=
AURORA_REPO=lengxiv/aurora

# 凭据/会话密钥文件路径（默认位于 AURORA_STATE_DIR 下）
AURORA_AUTH_FILE=/var/lib/aurora/.auth
AURORA_SECRET_FILE=/var/lib/aurora/.secret

# Leave AURORA_AUTH_PASS empty to generate a random password in AURORA_AUTH_FILE.
# If set, it must be at least 12 characters.
AURORA_AUTH_USER=admin
AURORA_AUTH_PASS=

# Optional qBittorrent adapter
AURORA_QBIT_URL=http://127.0.0.1:8080
AURORA_QBIT_USER=
AURORA_QBIT_PASS=

# Optional rclone RC adapter. The /rclone/ suffix must match --rc-baseurl.
AURORA_RCLONE_RC=http://127.0.0.1:5572/rclone
AURORA_RCLONE_RC_AUTH=

# Optional Jellyfin adapter
AURORA_JELLYFIN=http://127.0.0.1:8096
AURORA_JELLYFIN_TOKEN=

# Optional Telegram fallback settings
AURORA_TG_BOT_TOKEN=
AURORA_TG_CHAT_ID=
